# ─── Metafy OAuth (packages/api — Metafy developer app) ───────────────────────
# Create app at https://metafy.gg/account/settings/developers
# Authorization URL: https://metafy.gg/auth/authorize  Token: https://metafy.gg/irk/oauth/token
# Non-secret vars also in packages/api/wrangler.jsonc → vars. Secret via wrangler secret put.
METAFY_CLIENT_ID=
METAFY_CLIENT_SECRET=
METAFY_COMMUNITY_ID=
METAFY_REDIRECT_URI=http://localhost:3000/auth/metafy/callback
# Webhook secret — only available to Metafy Partners. Set in Metafy account settings.
METAFY_WEBHOOK_SECRET=

# ─── API ───────────────────────────────────────────────────────────────────────
CARD_PROVIDER=supabase
API_PORT=3000
LOG_LEVEL=info

# How often to refresh provider stats from Supabase (ms). Default: 6h
CACHE_REFRESH_INTERVAL_MS=21600000

# ─── Supabase (required) ───────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_ANON_KEY=your-anon-key-here

# Version strings stored with new user consent acceptances (API registration). Defaults to "1" if unset.
LEGAL_TERMS_VERSION=1
LEGAL_PRIVACY_VERSION=1

# packages/api Worker — also add SUPABASE_ANON_KEY via wrangler secret (see secrets.required in packages/api/wrangler.jsonc).

# ─── Upstash Redis (optional — speeds up provider restarts via snapshot cache) ──
# Create a free database at https://console.upstash.com
# Free tier (10k req/day, 256MB) is sufficient for ~650 cards
UPSTASH_REDIS_REST_TOKEN=<rest-token>
UPSTASH_REDIS_REST_URL=https://<database-name>.upstash.io

# ─── Discord Bot (packages/discord-bot) ────────────────────────────────────────
# Plain vars: packages/discord-bot/wrangler.jsonc (API_BASE_URL, SITE_BASE_URL).
# secrets.required — Wrangler fails deploy if unset:
#   cd packages/discord-bot && wrangler secret put DISCORD_PUBLIC_KEY   # Ed25519 public key (Discord Portal)
#   wrangler secret put DISCORD_BOT_TOKEN
#   wrangler secret put DISCORD_APPLICATION_ID

# ─── Ingest Worker (packages/ingest-worker) ────────────────────────────────────
# Plain vars: packages/ingest-worker/wrangler.jsonc (vars.RIFTCODEX_BASE_URL).
# secrets.required — Wrangler fails deploy if unset:
#   cd packages/ingest-worker && wrangler secret put SUPABASE_URL && wrangler secret put SUPABASE_SERVICE_ROLE_KEY
# Deploy: cd packages/ingest-worker && wrangler deploy --config wrangler.jsonc (root wrangler.jsonc is unrelated).

# ─── Reddit Bot (packages/reddit-bot) ──────────────────────────────────────────
# Standalone Devvit app — configured per-install via Devvit settings, not env vars.
# apiBaseUrl and siteBaseUrl are set after deploy: npx devvit settings set apiBaseUrl

# --- Web (packages/web — Next.js on Cloudflare Workers) ──────────────────────────
# Local dev — copy to packages/web/.env.local or pass via root --env-file:
NEXT_PUBLIC_API_URL=http://localhost:8789
NEXT_PUBLIC_APP_URL=http://localhost:3000
C15T_DATABASE_URL=

# Production Worker (packages/web/wrangler.jsonc):
# - NEXT_PUBLIC_* plain vars must match what you pass into `opennextjs-cloudflare build`
#   (see GitHub Actions vars NEXT_PUBLIC_API_URL / NEXT_PUBLIC_APP_URL).
# - C15T_DATABASE_URL is declared under secrets.required — Wrangler fails deploy if unset.
#   Set remotely: cd packages/web && wrangler secret put C15T_DATABASE_URL
#   Local wrangler dev: put only that key in packages/web/.dev.vars (Wrangler loads listed secrets only).

# Supabase Transaction Pooler — Dashboard → Database → Connection String → Transaction mode
# Required for c15t consent backend. Use port 6543, not 5432. Append ?prepare=false.
# C15T_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?prepare=false