# ─── API ───────────────────────────────────────────────────────────────────────
CARD_PROVIDER=supabase
API_PORT=3000
LOG_LEVEL=info

# How often to refresh provider stats from Supabase (ms). Default: 6h
CACHE_REFRESH_INTERVAL_MS=21600000

# ─── Supabase (required) ───────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# packages/api Worker — also add SUPABASE_ANON_KEY via wrangler secret (see secrets.required in packages/api/wrangler.jsonc).

# ─── Upstash Redis (optional — speeds up provider restarts via snapshot cache) ──
# Create a free database at https://console.upstash.com
# Free tier (10k req/day, 256MB) is sufficient for ~650 cards
UPSTASH_REDIS_REST_TOKEN=<rest-token>
UPSTASH_REDIS_REST_URL=https://<database-name>.upstash.io

# ─── Discord Bot (packages/discord-bot) ────────────────────────────────────────
# Plain vars: packages/discord-bot/wrangler.jsonc (API_BASE_URL, SITE_BASE_URL).
# secrets.required — Wrangler fails deploy if unset:
#   cd packages/discord-bot && wrangler secret put DISCORD_PUBLIC_KEY   # Ed25519 public key (Discord Portal)
#   wrangler secret put DISCORD_BOT_TOKEN
#   wrangler secret put DISCORD_APPLICATION_ID

# ─── Ingest Worker (packages/ingest-worker) ────────────────────────────────────
# Plain vars: ingest-worker/wrangler.toml ([vars] RIFTCODEX_BASE_URL).
# secrets.required — Wrangler fails deploy if unset:
#   cd packages/ingest-worker && wrangler secret put SUPABASE_URL && wrangler secret put SUPABASE_SERVICE_ROLE_KEY
# Always deploy with: wrangler deploy --config wrangler.toml (root wrangler.jsonc is unrelated).

# ─── Reddit Bot (packages/reddit-bot) ──────────────────────────────────────────
# Standalone Devvit app — configured per-install via Devvit settings, not env vars.
# apiBaseUrl and siteBaseUrl are set after deploy: npx devvit settings set apiBaseUrl

# --- Web (packages/web — Next.js on Cloudflare Workers) ──────────────────────────
# Local dev — copy to packages/web/.env.local or pass via root --env-file:
NEXT_PUBLIC_API_URL=http://localhost:8789
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production Worker: NEXT_PUBLIC_* plain vars must match what you pass into `opennextjs-cloudflare build`
# (see GitHub Actions vars NEXT_PUBLIC_API_URL / NEXT_PUBLIC_APP_URL in .github/workflows/web.yml).
