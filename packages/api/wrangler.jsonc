{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "riftseer-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-29",
	"workers_dev": false,
	"preview_urls": false,
	"dev": { "port": 8789 },
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	"vars": {
		"CARD_PROVIDER": "supabase",
		"LEGAL_TERMS_VERSION": "2",
		// 4 — 30 July 2026: admin edit attribution and audit retention.
		"LEGAL_PRIVACY_VERSION": "4",
		// Public site origin used to build absolute riftseer_uri values on every
		// card response. Override per-environment if needed.
		"SITE_ORIGIN": "https://riftseer.com",
		// Comma-separated Supabase auth user UUIDs allowed to call /api/v1/admin.
		// Keep empty until the production admin UUIDs are configured.
		"ADMIN_USER_IDS": "",
		// Shared card-image custom domain used by admin uploads.
		"CARD_IMAGE_BASE_URL": "https://img.riftseer.com",
		// Metafy OAuth — non-confidential: both values are sent to the browser as
		// part of the authorize URL.
		"METAFY_COMMUNITY_ID": "riftseer",
		"METAFY_REDIRECT_URI": "https://riftseer.com/auth/metafy/callback",
	},
	"r2_buckets": [
		{
			"binding": "CARD_IMAGES",
			"bucket_name": "riftseer-cards"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "CARD_IMAGE_QUEUE",
				"queue": "riftseer-card-images"
			}
		]
	},
	// Required for core API + Supabase auth routes.
	// https://developers.cloudflare.com/workers/wrangler/configuration/#secrets-configuration-property
	//
	// This list is an ALLOWLIST, not just a deploy-time assertion: declaring it
	// replaces wrangler's .dev.vars/.env inference, so a key missing from here is
	// silently dropped and never reaches the Worker in `wrangler dev`. Omitting
	// the "optional" secrets is what made SUPABASE_AUTH_URL a no-op — the code
	// read it, .dev.vars.example documented it, and the value never arrived.
	//
	// So: every secret `process.env` is read for, in this Worker or in
	// @riftseer/core, has to appear below. Ones that are genuinely optional log a
	// startup warning when unset, which is the visible half of the trade — far
	// cheaper than a binding that vanishes without a word.
	//
	// Remote values are set with `wrangler secret put <name>`.
	"secrets": {
		"required": [
			"SUPABASE_URL",
			"SUPABASE_SERVICE_ROLE_KEY",
			"SUPABASE_ANON_KEY",
			// Optional — sign-in resolves against SUPABASE_URL when unset.
			"SUPABASE_AUTH_URL",
			"SUPABASE_AUTH_ANON_KEY",
			"METAFY_CLIENT_SECRET",
			// Not confidential, but the value is not committed.
			"METAFY_CLIENT_ID",
			// Optional — Metafy Partners only.
			"METAFY_WEBHOOK_SECRET",
			// Optional — leave unset to disable Redis / affiliate links.
			"UPSTASH_REDIS_REST_URL",
			"UPSTASH_REDIS_REST_TOKEN",
			"TCGPLAYER_AFFILIATE_ID"
		]
	}
}
