# Dependencies
node_modules/

# Build artifacts
dist/
*.tsbuildinfo

# Generated files
.next/
out/
next-env.d.ts

# Environment
.env
.env.local
.dev.vars
# `.dev.vars.local` is committed on purpose — it holds local-docker placeholders,
# not credentials. Real values that ride alongside it go here instead.
.dev.vars.local.secrets

# Wrangler (Cloudflare Workers)
.wrangler/

# npm
# npm lockfiles are ignored except for the two standalone npm packages,
# whose installs must be reproducible in CI.
package-lock.json
!apps/reddit-bot/package-lock.json
!apps/raycast-extension/package-lock.json

# Supabase
.supabase/
supabase/.branches/
supabase/.temp/

# macOS
.DS_Store

# Editor
# settings.json and extensions.json are committed: formatter, lint fixes on
# save and the recommended extensions are part of the repo, not the machine.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
.agents/
.claude/