// Renovate needs the GitHub App installed on the repository before this file
// does anything: https://github.com/apps/renovate. docs/renovate.md covers the
// cadence, where the logs are and how to force a run.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    // One PR a week for everything non-major, so the batch is reviewed once.
    // Majors stay separate because those are the ones that need reading.
    "group:allNonMajor",
    "schedule:weekly",
  ],
  // Bun workspace at the root (bun.lock) plus the two standalone npm packages
  // (packages/reddit-bot, packages/raycast-extension) with their own
  // package-lock.json. Renovate finds every package.json itself; this only
  // keeps the standalone lockfiles current when nothing in them is bumped.
  lockFileMaintenance: { enabled: true, extends: ["schedule:weekly"] },
  // The default rangeStrategy keeps existing ranges and pins as written, so
  // the root `overrides` block (typescript, elysia, kysely, typebox) is bumped
  // in place rather than bypassed.
  // Skip a release's first days so a compromised publish can be yanked before
  // it lands here.
  minimumReleaseAge: "3 days",
  // Dependabot alerts are switched off on the repository, so GitHub gives
  // Renovate no vulnerability signal. OSV does, and vulnerability PRs open
  // outside the weekly window and past the hourly and concurrent PR limits.
  osvVulnerabilityAlerts: true,
  // ignorePaths is not mergeable: setting it here replaces the list
  // config:recommended inherits from :ignoreModulesAndTests rather than adding
  // to it, so that list is repeated verbatim before docs/. docs/ is the
  // Docusaurus site, deleted in the docs chunk of the overhaul; delete that
  // entry with it.
  ignorePaths: [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "docs/**",
  ],
  packageRules: [
    {
      // Action bumps are one-line tag or digest changes. One PR for all of
      // them, majors included, instead of one per action.
      matchManagers: ["github-actions"],
      groupName: "GitHub Actions",
    },
    {
      // The docker and CI Postgres majors follow the hosted Supabase Postgres
      // major, which Renovate cannot see. Bump them by hand when that moves.
      matchDatasources: ["docker"],
      matchPackageNames: ["postgres"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      // `@c15t/backend` pulls in fumadb, and fumadb still pins `kysely ^0.28`
      // (0.3.0, the newest c15t ships). kysely 0.29 dropped the
      // `DEFAULT_MIGRATION_TABLE` and `DEFAULT_MIGRATION_LOCK_TABLE` exports
      // fumadb imports, so the root override taking 0.29 breaks the web build.
      // `kysely-postgres-js` v4 wants 0.29 in turn, so it waits on the same
      // thing. Drop both entries once c15t ships a fumadb 0.6 build.
      matchPackageNames: ["kysely"],
      allowedVersions: "<0.29.0",
    },
    {
      matchPackageNames: ["kysely-postgres-js"],
      allowedVersions: "<4.0.0",
    },
  ],
}
