{
  "config": {
    "MD013": false,
    "MD036": false,
    "MD060": false,
    "MD024": {
      "siblings_only": true,
    },
  },
  "globs": [
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "CHANGELOG.md",
    "AGENTS.md",
    "CONTEXT.md",
    "docs/**/*.md",
    "apps/*/AGENTS.md",
    "packages/*/AGENTS.md",
    "apps/*/docs/**/*.md",
    "packages/*/docs/**/*.md",
    "supabase/docs/**/*.md",
  ],
  "ignores": ["**/node_modules/**"],
}
