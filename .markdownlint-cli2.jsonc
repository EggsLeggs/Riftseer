{
  "config": {
    "MD013": false,
    "MD036": false,
    "MD060": false,
    "MD024": {
      "siblings_only": true,
    },
  },
  "globs": [
    "README.md",
    "docs/doc-pages/**/*.md",
    "docs/README.md",
    "docs/adding-an-env-var.md",
    "docs/renovate.md",
    "packages/*/docs/**/*.md",
    "supabase/docs/**/*.md",
  ],
  "ignores": ["**/node_modules/**", "**/build/**", "**/.docusaurus/**"],
}
